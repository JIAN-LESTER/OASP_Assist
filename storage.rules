rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    //  NEW: Announcement images — public read, Cloud Functions write via Admin SDK
    match /announcements/{allPaths=**} {
      allow read: if true;   // public, no auth needed
      allow write: if false; // Cloud Functions use Admin SDK (bypasses these rules)
    }

    // Admin uploads
    match /admin_uploads/{allPaths=**} {
      allow write: if request.auth != null && request.auth.token.admin == true;
      allow read: if request.auth != null;
    }

    // User uploads
    match /user_uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }
  }
}