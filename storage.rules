rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin']
      );
    }

    //   Announcement images — public read, Cloud Functions write via Admin SDK
    match /announcements/{allPaths=**} {
      allow read: if true;   // public, no auth needed
      allow write: if false; // Cloud Functions use Admin SDK (bypasses these rules)
    }

    // Admin uploads
    match /admin_uploads/{allPaths=**} {
      allow read, write: if isStaffOrAdmin();
    }

    // User uploads
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() &&
        (request.auth.uid == userId || isStaffOrAdmin());
    }
  }
}
